{
  "name": "tonstable",
  "version": "1.0.0",
  "description": "TON Stable Wallet - A secure and user-friendly wallet for TON blockchain",
  "author": "TON Stable Team",
  "homepage": "https://tonstable.github.io",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "build:web": "expo export",
    "build:extension": "expo export && node scripts/build-extension.js",
    "build:desktop": "electron-builder -mw",
    "generate:icons": "node scripts/generate-icons.js",
    "build:all": "npm run generate:icons && npm run build:web && npm run build:desktop && npm run build:extension && mkdir -p builds && cp -r dist/* builds/",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages -d dist --repo https://github.com/tonstable/tonstable.github.io.git --branch main"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^4",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@shopify/flash-list": "^1.6.3",
    "@ton/core": "^0.56.1",
    "@ton/crypto": "^3.2.0",
    "@ton/ton": "^13.9.0",
    "@tonconnect/sdk": "^3.0.0",
    "expo": "~50.0.5",
    "expo-status-bar": "~1.11.1",
    "i18next": "^23.7.16",
    "react": "18.2.0",
    "react-i18next": "^14.0.0",
    "react-native": "0.73.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-web": "~0.19.10",
    "react-native-webview": "^13.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/metro-runtime": "~3.1.3",
    "@types/react": "~18.2.45",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-is-dev": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^12.0.0",
    "gh-pages": "^6.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "react-dom": "18.2.0",
    "sharp": "^0.34.1",
    "typescript": "^5.1.3"
  },
  "private": true,
  "eslintConfig": {
    "extends": "universe/native"
  },
  "build": {
    "appId": "com.tonstable.wallet",
    "mac": {
      "category": "public.app-category.finance",
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  }
}
