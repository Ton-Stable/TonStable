{
  "manifest_version": 3,
  "name": "TonStable Wallet",
  "version": "1.0.0",
  "description": "Кроссплатформенный криптокошелек с поддержкой TON и других криптовалют",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.ton.org/*",
    "https://*.tonapi.io/*",
    "https://*.coingecko.com/*",
    "https://*.coinmarketcap.com/*"
  ]
} 